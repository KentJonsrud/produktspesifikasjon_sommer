        <sc:Property>
         <sc:name>posisjon</sc:name>
         <sc:id>C12_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>sted som objektet eksisterer på</sc:DescriptorValue>
           </sc:descriptorValues>
