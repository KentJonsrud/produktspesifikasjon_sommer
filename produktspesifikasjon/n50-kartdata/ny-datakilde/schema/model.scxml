          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>angivelse av høydekurvens høyde over høydereferansen i meter

-- Definition --
indication of the depression curve's height above the height reference in metres - to be given with decimals if necessary</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
