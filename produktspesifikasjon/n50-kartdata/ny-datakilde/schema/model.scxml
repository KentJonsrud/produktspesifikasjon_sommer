    <sc:Package>
     <sc:name>Stedsnavn</sc:name>
     <sc:id>P9</sc:id>
     <sc:classes>
      <sc:Class>
       <sc:name>StedsnavnTekst</sc:name>
       <sc:id>C103</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>StedsnavnTekst er stedsnavn fra SSR tilpasset visning på kart</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:supertypes>
        <sc:SupertypeId>C104</sc:SupertypeId>
       </sc:supertypes>
       <sc:properties>
        <sc:Property>
         <sc:name>navneobjekthovedgruppe</sc:name>
         <sc:id>C103_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>hovedgruppene følger i hovedsak Inspire "NamedPlaceTypeValue", men populatedPlace og building er samlet under bebyggelse og hydrography er delt mellom sjø og ferskvann.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeId>C144</sc:typeId>
         <sc:typeName>Navneobjekthovedgruppe</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>navneobjektgruppe</sc:name>
         <sc:id>C103_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>inndeling i kategorier under hver hovedgruppe.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeId>C145</sc:typeId>
         <sc:typeName>Navneobjektgruppe</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>navneobjekttype</sc:name>
         <sc:id>C103_3</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>stedets navneobjekttype er en underinndeling av navneobjektgruppene som igjen er inndeling av navneobjekthovedgruppene.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>3</sc:sequenceNumber>
         <sc:typeId>C146</sc:typeId>
         <sc:typeName>Navneobjekttype</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>språk</sc:name>
         <sc:id>C103_4</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>angir hvilket språk teksten hører til, norsk, kvensk, nordsamisk, lulesamisk, sørsamisk osv.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>SPRÅK</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>4</sc:sequenceNumber>
         <sc:typeId>C147</sc:typeId>
         <sc:typeName>SpråkKode</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>stedsnavnnummer</sc:name>
         <sc:id>C103_5</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>stedsnummer, stedsnavnnummer og skrivemåtenummer skal sammen utgjøre en såkalt tematisk id som brukes av registerførere som opplslagsnummer. identifikatoren ligner litt på Gnr/Bnr/Fnr.

&lt;b&gt;Stedsnavnnummer&lt;/b&gt; er et løpende nummer (starter på 1) systemet gir stedsnavnet som en identifikator. stedsnavnnummeret er kun unikt under et stedsnummer og kan ikke brukes om igjen for dette stedsnavnet.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>STEDSNAVNNUMMER</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>5</sc:sequenceNumber>
         <sc:typeName>Integer</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>språkprioritering</sc:name>
         <sc:id>C103_6</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>stedsnavnet sin prioritering i forhold til de ulike språkgruppene</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>SPRÅKPRIORITERING</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>6</sc:sequenceNumber>
         <sc:typeId>C148</sc:typeId>
         <sc:typeName>SpråkprioriteringKode</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>stedsnummer</sc:name>
         <sc:id>C103_7</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>stedsnummer, stedsnavnsnummer og skrivemåtenummer skal sammen utgjøre en såkalt tematisk id som brukes av registerførere som opplslagsnummer. Identifikatoren ligner litt på Gnr/Bnr/Fnr.

&lt;b&gt;Stedsnummeret&lt;/b&gt; er et løpende nummer systemet gir stedet som en identifikator. Stedsnummeret er unikt og kan ikke brukes om igjen.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>STEDSNUMMER</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>7</sc:sequenceNumber>
         <sc:typeName>Integer</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>skrivemåtenummer</sc:name>
         <sc:id>C103_8</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>stedsnummer, stedsnavnsnummer og skrivemåtenummer skal sammen utgjøre en såkalt tematisk id som brukes av registerførere som opplslagsnummer. Identifikatoren ligner litt på Gnr/Bnr/Fnr.

&lt;b&gt;Skrivemåtenummer&lt;/b&gt; er et løpende nummer systemet gir skrivemåten som en identifikator. skrivemåtenummeret er kun unikt under et stedsnavnsnummer og kan ikke brukes om igjen for dette stedsnavnet.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>SKRIVEMÅTENUMMER</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>8</sc:sequenceNumber>
         <sc:typeName>Integer</sc:typeName>
        </sc:Property>
       </sc:properties>
      </sc:Class>
      <sc:Class>
       <sc:name>FellesTekst</sc:name>
       <sc:id>C104</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>abstrakt objekt som bærer en felles egenskaper som brukes på tekstobjektene</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:isAbstract>true</sc:isAbstract>
       <sc:properties>
        <sc:Property>
         <sc:name>geometri</sc:name>
         <sc:id>C104_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>kurve-geometri på tekstobjekter brukes slik: Punkt nr. 1 på kurva er objektets referansekoordinat. Punkt nr. 2 er tekstens plasseringskoordinat. Punkt nr. 3 angir retning på teksten. Dersom kurva inneholder flere koordinater angir disse forløp på teksten.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeName>GM_Curve</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>streng</sc:name>
         <sc:id>C104_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>teksten som skal presenteres på kartet</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>STRENG</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeName>CharacterString</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>oppdateringsdato</sc:name>
         <sc:id>C104_3</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>dato for siste endring på objektetdataene

-Definition-
Date and time at which this version of the spatial object was inserted or changed in the spatial data set.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>OPPDATERINGSDATO</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>3</sc:sequenceNumber>
         <sc:typeName>Date</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>datafangstdato</sc:name>
         <sc:id>C104_4</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>dato når objektet siste gang ble registrert/observert/målt i terrenget

Merknad: I mange tilfeller er denne forskjellig fra Oppdateringsdato, da registrerte endringer kan bufres i en kortere eller lengre periode før disse legges inn i databasen.
Ved førstegangsregistrering settes Datafangstdato lik førsteDatafangstdato.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>DATAFANGSTDATO</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>4</sc:sequenceNumber>
         <sc:typeName>Date</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>tekstformatering</sc:name>
         <sc:id>C104_5</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>ulike egenskaper til brukt for å presentere teksten på mediumet</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>5</sc:sequenceNumber>
         <sc:typeId>C111</sc:typeId>
         <sc:typeName>Tekstformatering</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>fulltekst</sc:name>
         <sc:id>C104_6</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>navnet i SSR som skal vises på kartet. Vil i de fleste tilfeller være likt Streng, men kan avvike dersom det av kartografiske hensyn bare vises deler av navnet e.l.</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>FULLTEKST</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>6</sc:sequenceNumber>
         <sc:typeName>CharacterString</sc:typeName>
        </sc:Property>
       </sc:properties>
      </sc:Class>
