            <sc:DescriptorValue>sted som objektet eksisterer på</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
