         <sc:id>C88_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>angivelse av punktets høyde, og oppgis i meter

-- Definition --
indication of the height of the point, to be given with decimals if necessary</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
