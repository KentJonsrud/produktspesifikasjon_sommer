       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>avgrensning i havet av statens suverenitetsområde, beregnet 12 nm (22 224 m) utenfor og parallelt med grunnlinjen</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>TERRITORIALGRENSE</sc:Value>
         </sc:values>
        </sc:TaggedValue>
       </sc:taggedValues>
       <sc:supertypes>
        <sc:SupertypeId>C1</sc:SupertypeId>
       </sc:supertypes>
       <sc:properties>
        <sc:Property>
         <sc:name>grense</sc:name>
         <sc:id>C8_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>forløp som følger overgang mellom ulike fenomener</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeName>GM_Curve</sc:typeName>
        </sc:Property>
