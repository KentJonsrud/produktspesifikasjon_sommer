    <sc:Class>
     <sc:name>ValgkretsId</sc:name>
     <sc:id>C14</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>datatype</sc:Stereotype>
     </sc:stereotypes>
     <sc:properties>
      <sc:Property>
       <sc:name>valgkretsnummer</sc:name>
       <sc:id>C14_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>løpenummer innenfor valgkretsens kommune</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
