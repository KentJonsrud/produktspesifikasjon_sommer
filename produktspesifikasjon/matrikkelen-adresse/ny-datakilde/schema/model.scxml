    <sc:Class>
     <sc:name>TypeAtkomst</sc:name>
     <sc:id>C15</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>ulike atkomster i forhold til årstid (f.eks ikke vinterbrøytede veger). Senere kan en tenke seg å utvide med atkomst vareleveranse osv</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>atkomst</sc:name>
       <sc:id>C15_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>generell atkomst, uavhengig av årstid</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>atkomstSommer</sc:name>
       <sc:id>C15_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>atkomst sommerstid. Kan være en annen enn atkomst vinterstid pga ikke brøytede veger, båt-trafikk eller annet</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>atkomstVinter</sc:name>
       <sc:id>C15_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>atkomst vinterstid. Kan være en annen enn atkomst sommersstid pga ikke brøytede veger, båt-trafikk eller annet</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>AdressetilleggsnavnKildeKode</sc:name>
     <sc:id>C16</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>Kodeliste over opphav til adressetilleggsnavn, som også er årsaken til at de er registrert i matrikkelen.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>krevdAvEier</sc:name>
       <sc:id>C16_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>&lt;font color="#333333"&gt;Når adressen gjelder et gårdsbruk, kan den som har grunnbokshjemmel til eiendommen som eier, kreve at den offisielle adressen også skal omfatte gårdens bruksnavn, dersom navnet faller språklig og geografisk sammen med et nedarvet stedsnavn, jf. lov 18. mai 1990 nr. 11 om stadnamn (&lt;/font&gt;matrikkelforskriftens § 54 1. ledd)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>anmodetAvHjemmelshaver</sc:name>
       <sc:id>C16_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>&lt;font color="#333333"&gt;Når adressen gjelder en særlig kjent institusjon eller bygning og allmenne hensyn taler for det, kan kommunen på anmodning fra registrert eier fastsette at den offisielle adressen også skal omfatte et navn på institusjonen eller bygningen (&lt;/font&gt;matrikkelforskriftens § 54 2. ledd)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>matrikkeladressenavn</sc:name>
       <sc:id>C16_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>&lt;font color="#333333"&gt;Adresser i område med matrikkeladresser som ikke har tildelt et adressetilleggsnavn etter reglene i § 54, kan tilordnes et matrikkeladressenavn etter &lt;/font&gt;matrikkelforskriftens § 55 3. ledd. Hvis det tildeles adressetilleggsnavn etter § 54 strykes matrikkeladressenavnet</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>ikkeOppgitt</sc:name>
       <sc:id>C16_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>"Ikke oppgitt" brukes på adresser uten adressetilleggsnavn.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>tildeltAvKommunen</sc:name>
       <sc:id>C16_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>&lt;font color="#333333"&gt;Kommunen kan tildele adresser innenfor mindre grender, bolig- eller hyttefelt eller andre avgrensede områder et felles adressetilleggsnavn (&lt;/font&gt;Matrikkelforskriftens § 54 3. ledd, men tildeling etter 1. eller 2. ledd går foran 3. ledd)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>5</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>Kommunenummer</sc:name>
     <sc:id>C17</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>nummerering av kommuner i henhold til Statistisk sentralbyrå sin offisielle liste samt et utvalg av utgåtte numre
Merknad: Det presiseres at kommune alltid skal ha 4 sifre, dvs. eventuelt med ledende null. Kommune benyttes for kopling mot en rekke andre registre som også benytter 4 sifre.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:taggedValues>
      <sc:TaggedValue>
       <sc:name>codeList</sc:name>
       <sc:values>
        <sc:Value>http://skjema.geonorge.no/SOSI/kodeliste/AdmEnheter/2020/Kommunenummer</sc:Value>
       </sc:values>
      </sc:TaggedValue>
