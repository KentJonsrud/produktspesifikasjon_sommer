        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>abstrakt objekttype som bærer sentrale egenskaper som er anbefalt for bruk i produktspesifikasjoner.

Merknad: Disse egenskapene skal derfor ikke modelleres inn i fagområdemodeller.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:isAbstract>true</sc:isAbstract>
       <sc:properties>
        <sc:Property>
         <sc:name>identifikasjon</sc:name>
         <sc:id>C5_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>unik identifikasjon av et objekt</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>IDENT</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeId>C8</sc:typeId>
         <sc:typeName>Identifikasjon</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>eksternPeker</sc:name>
         <sc:id>C5_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>referanse til objektet i et eksternt system, som ikke er Nasjonal vegdatabank (NVDB).</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeName>URI</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>nvdbPeker</sc:name>
         <sc:id>C5_3</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>referanse til objektet i Nasjonal vegdatabank (NVDB).</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
