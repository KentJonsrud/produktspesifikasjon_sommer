    <sc:Class>
     <sc:name>LedningHøydereferanse</sc:name>
     <sc:id>C20</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>den høyden som høydedelen av stedfestingen til komponenten ( Ledning/beliggenhet og Kopling/posisjon) referer til.

Merknad: På VA-ledning er det kun to som er aktuelle:
- ToppUtvendig: ledning overkant, brukes på vannledning
- BunnInnvendig: brukes på avløpsledning</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>toppUtvendig</sc:name>
       <sc:id>C20_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>høydereferansen er til toppen av komponenten</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>toppInnvendig</sc:name>
       <sc:id>C20_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>høydereferansen er topp innvendig komponent</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>senter</sc:name>
       <sc:id>C20_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>høydereferansen er senter innvendig

Eksempel: Dersom en ønsker å representere volumet på rør, kan dette gjøres med å angi LedningHøydereferanse = senter og supplere dette med passende radius.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>bunnInnvendig</sc:name>
       <sc:id>C20_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>høydereferansen er bunn innvendig

Eksempel: Dette er nyttig når en skal modellere fall på avløpsrør</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>underkantUtvendig</sc:name>
       <sc:id>C20_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>høydereferansen er bunn utvendig</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>5</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>påBakken</sc:name>
       <sc:id>C20_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>høydereferanse er på bakken

Merknad: Mange ledninger er målt på lukket grøft</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>6</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>fot</sc:name>
       <sc:id>C20_7</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>naturlig å bruke for eksempel på master/mastefundamenter</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>7</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>ukjent</sc:name>
       <sc:id>C20_8</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>brukes der det ikke er kjent hva som er benyttet som høydereferanse</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>8</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
   </sc:classes>
