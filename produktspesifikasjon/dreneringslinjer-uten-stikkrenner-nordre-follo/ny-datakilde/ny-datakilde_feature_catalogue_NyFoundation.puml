@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Dreneringslinjer uten stikkrenner Nordre Follo - Ny datakilde - NyFoundation

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "NyFoundation" {

  class MiscFeatureType <<featureType>> {
    + highestElevation [0..1] : ElevationMeasureMeta
    + miscFeatureTypeDescription [0..1] : CharacterStringMeta
    + heightAboveSurfaceLevel [0..1] : HeightMeasureMeta
  }

  abstract class FeatureEntity <<featureType>> {
    + geometry [1] : GM_Object
  }

  class IdentifiedQualityIssue <<featureType>> {
    + qualityIssueImpact [0..1] : CharacterStringMeta
    + qualityIssueDescription [0..1] : CharacterStringMeta
  }

  class VoidCollectionArea <<featureType>> {
    + voidCollectionReason [0..*] : VoidCollectionArea_voidCollectionReasonMeta
    + voidCollectionType [0..*] : VoidCollectionArea_voidCollectionTypeMeta
  }

  class GeneralLocation <<featureType>> {
    + namedLocationType [0..1] : GeneralLocation_namedLocationTypeMeta
    + thematicClassification [0..1] : GeneralLocation_thematicClassificationMeta
    + informationReference [0..*] : CharacterStringMeta
  }

  class OrganisationalUnit <<featureType>> {
    + contactInfo [1] : CI_ContactMeta
  }

  class ElevationMeasureMeta <<dataType>> {
    + valueOrReason [1] : ElevationMeasureReason
  }

  class CharacterStringMeta <<dataType>> {
    + valueOrReason [1] : CharacterStringReason
  }

  class HeightMeasureMeta <<dataType>> {
    + valueOrReason [1] : HeightMeasureReason
  }

  class VoidCollectionArea_voidCollectionReasonMeta <<dataType>> {
    + valueOrReason [1] : VoidCollectionArea_voidCollectionReasonReason
  }

  class VoidCollectionArea_voidCollectionTypeMeta <<dataType>> {
    + valueOrReason [1] : VoidCollectionArea_voidCollectionTypeReason
  }

  class GeneralLocation_namedLocationTypeMeta <<dataType>> {
    + valueOrReason [1] : GeneralLocation_namedLocationTypeReason
  }

  class GeneralLocation_thematicClassificationMeta <<dataType>> {
    + valueOrReason [1] : GeneralLocation_thematicClassificationReason
  }

  class CI_ContactMeta <<dataType>> {
    + valueOrReason [1] : CI_ContactReason
  }
}

package "Eksterne referanser" <<Frame>> {
  class ActorEntity <<external>> {
  }
  class AddressInfo <<external>> {
  }
  class AeronauticalObstacleInfo <<external>> {
  }
  class Entity <<external>> {
  }
  class FeatureMetadata <<external>> {
  }
  class GeoNameInfo <<external>> {
  }
  class HumanActivityCapacityInfo <<external>> {
  }
  class Organisation <<external>> {
  }
  class RestrictionInfo <<external>> {
  }
  class SourceInfo <<external>> {
  }
}

FeatureEntity <|-- MiscFeatureType
MiscFeatureType --> AeronauticalObstacleInfo : aeroObstacleDescribedBy [0..1]
MiscFeatureType --> AddressInfo : hasLocationAddress [0..*]
MiscFeatureType --> HumanActivityCapacityInfo : hasCapacity [0..*]
Entity <|-- FeatureEntity
FeatureEntity --> FeatureMetadata : featureMetadata [1]
FeatureEntity --> GeoNameInfo : [0..*]
FeatureEntity --> SourceInfo : sourceInfoDescribedBy [0..*]
FeatureEntity --> RestrictionInfo : restrictionInfo [1]
FeatureEntity <|-- IdentifiedQualityIssue
FeatureEntity <|-- VoidCollectionArea
FeatureEntity <|-- GeneralLocation
GeneralLocation --> AddressInfo : hasLocationAddress [0..*]
ActorEntity <|-- OrganisationalUnit
OrganisationalUnit --> Organisation : mainOrganisation [0..*]

@enduml
