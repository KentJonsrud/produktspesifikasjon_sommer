@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Dreneringslinjer uten stikkrenner Nordre Follo - Ny datakilde - Oversikt

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "NyFoundation" {
  class MiscFeatureType <<featureType>> {
  }
  abstract class FeatureEntity <<featureType>> {
  }
  class IdentifiedQualityIssue <<featureType>> {
  }
  class VoidCollectionArea <<featureType>> {
  }
  class GeneralLocation <<featureType>> {
  }
  class OrganisationalUnit <<featureType>> {
  }
}

package "NyTransportation" {
  class TunnelMouth <<featureType>> {
  }
  class TurnaroundSite <<featureType>> {
  }
  class CausewayStructure <<featureType>> {
  }
  class BridgeSpan <<featureType>> {
  }
  class BridgePier <<featureType>> {
  }
  class BridgeSuperstructure <<featureType>> {
  }
  class TransportationPlatform <<featureType>> {
  }
  class BridgeTower <<featureType>> {
  }
  class Bridge <<featureType>> {
  }
  class Tunnel <<featureType>> {
  }
  class TransRouteProtectStruct <<featureType>> {
  }
}


FeatureEntity <|-- TurnaroundSite
FeatureEntity <|-- CausewayStructure
CausewayStructure --> LandmarkInfo : navigationLandmarkInfoDescribedBy [0..1]
FeatureEntity <|-- BridgeSpan
FeatureEntity <|-- BridgePier
BridgePier --> LandmarkInfo : navigationLandmarkInfoDescribedBy [0..1]
FeatureEntity <|-- BridgeSuperstructure
BridgeSuperstructure --> LandmarkInfo : navigationLandmarkInfoDescribedBy [0..1]
BridgeSuperstructure --> AeronauticalObstacleInfo : aeroObstacleDescribedBy [0..1]
FeatureEntity <|-- BridgeTower
BridgeTower --> LandmarkInfo : navigationLandmarkInfoDescribedBy [0..1]
BridgeTower --> AeronauticalObstacleInfo : aeroObstacleDescribedBy [0..1]
FeatureEntity <|-- Bridge
Bridge --> LandmarkInfo : navigationLandmarkInfoDescribedBy [0..1]
Bridge --> AeronauticalObstacleInfo : aeroObstacleDescribedBy [0..1]
FeatureEntity <|-- Tunnel
FeatureEntity <|-- TransRouteProtectStruct
TransRouteProtectStruct --> LandmarkInfo : navigationLandmarkInfoDescribedBy [0..1]
FeatureEntity <|-- MiscFeatureType
MiscFeatureType --> AeronauticalObstacleInfo : aeroObstacleDescribedBy [0..1]
MiscFeatureType --> AddressInfo : hasLocationAddress [0..*]
MiscFeatureType --> HumanActivityCapacityInfo : hasCapacity [0..*]
Entity <|-- FeatureEntity
FeatureEntity --> FeatureMetadata : featureMetadata [1]
FeatureEntity --> GeoNameInfo : [0..*]
FeatureEntity --> SourceInfo : sourceInfoDescribedBy [0..*]
FeatureEntity --> RestrictionInfo : restrictionInfo [1]
FeatureEntity <|-- IdentifiedQualityIssue
FeatureEntity <|-- VoidCollectionArea
FeatureEntity <|-- GeneralLocation
GeneralLocation --> AddressInfo : hasLocationAddress [0..*]
ActorEntity <|-- OrganisationalUnit
OrganisationalUnit --> Organisation : mainOrganisation [0..*]

@enduml
