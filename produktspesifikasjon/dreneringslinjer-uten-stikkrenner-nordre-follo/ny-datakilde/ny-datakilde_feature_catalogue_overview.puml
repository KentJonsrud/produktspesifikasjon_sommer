@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Dreneringslinjer uten stikkrenner Nordre Follo - Ny datakilde - Oversikt

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Fellesegenskaper" {
  abstract class "Fellesegenskaper-Objektidentifikasjon" as Fellesegenskaper_Objektidentifikasjon <<featureType>> {
  }
  abstract class "Fellesegenskaper-StikkrenneKulvert" as Fellesegenskaper_StikkrenneKulvert <<featureType>> {
  }
  abstract class "StikkrenneKulvert-NVDB" as StikkrenneKulvert_NVDB <<featureType>> {
  }
}

package "StikkrenneKulvert-0.1" {
  class StikkrenneKulvertPunkt <<featureType>> {
  }
  class StikkrenneKulvertFlate <<featureType>> {
  }
  class StikkrenneKulvert <<featureType>> {
  }
  class StikkrenneKulvert3DGeometri <<featureType>> {
  }
}


StikkrenneKulvert_NVDB <|-- StikkrenneKulvertPunkt
StikkrenneKulvert_NVDB <|-- StikkrenneKulvertFlate
StikkrenneKulvert_NVDB <|-- StikkrenneKulvert
StikkrenneKulvert_NVDB <|-- StikkrenneKulvert3DGeometri
StikkrenneKulvert3DGeometri --> StikkrenneKulvertFlate : grunnriss [0..*]
Fellesegenskaper_Objektidentifikasjon <|-- Fellesegenskaper_StikkrenneKulvert
Fellesegenskaper_StikkrenneKulvert <|-- StikkrenneKulvert_NVDB

@enduml
