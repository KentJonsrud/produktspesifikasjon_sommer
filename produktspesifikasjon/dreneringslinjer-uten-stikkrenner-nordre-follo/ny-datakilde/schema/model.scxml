      <sc:Class>
       <sc:name>Bridge</sc:name>
       <sc:id>C9</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>-- Definition --
A structure that connects two locations and provides for the passage of a transportation route (for example: a road or a railway) over a terrain obstacle (for example: a waterbody, a gully, and/or a road).
-- Description --
A bridge consists of a set of two abutments and/or zero or more bridge piers joined by bridge spans. A bridge may serve, for example, as an overpass or a viaduct. In the context of a bridge, the scope of the term 'transportation route' includes the transportation of liquids or gases by means of either pipelines or aqueducts.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:supertypes>
        <sc:SupertypeId>C13</sc:SupertypeId>
       </sc:supertypes>
       <sc:properties>
        <sc:Property>
         <sc:name>directivity</sc:name>
         <sc:id>C9_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The side(s) of a feature that produce the greatest visual significance and/or reflectivity potential.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeId>C82</sc:typeId>
         <sc:typeName>Bridge_directivityMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>structMatType</sc:name>
         <sc:id>C9_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The primary type(s) of material composing a feature, exclusive of the surface.
-- Description --
The basis for 'primary' may be, for example, compositional dominance or structural organization.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..*</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeId>C83</sc:typeId>
         <sc:typeName>Bridge_structMatTypeMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>angleOfIntendedPassage</sc:name>
         <sc:id>C9_3</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The angular distance in the horizontal plane measured from true north (0 degrees) clockwise to the path on the feature (0-180 degrees) where passage was intended.
-- Description --
The path of intended passage may go across or over the feature (ex. a bridge) or through it (ex. a tunnel).
-- UnitOfMeasure --
arcDegree</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>3</sc:sequenceNumber>
         <sc:typeId>C43</sc:typeId>
         <sc:typeName>AngleMeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>bridgeInfoReliability</sc:name>
         <sc:id>C9_4</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The reliability of information regarding bridge military load classification and related characteristics.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>4</sc:sequenceNumber>
         <sc:typeId>C84</sc:typeId>
         <sc:typeName>Bridge_bridgeInfoReliabilityMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>controllingAuthorityIdent</sc:name>
         <sc:id>C9_5</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The recognized authority responsible for establishing and maintaining the administrative affairs of all matters relating to a particular field or subject.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..*</sc:cardinality>
         <sc:sequenceNumber>5</sc:sequenceNumber>
         <sc:typeId>C20</sc:typeId>
         <sc:typeName>CharacterStringMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>bridgeOpeningType</sc:name>
         <sc:id>C9_6</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The type of structure or mechanism by which a bridge or bridge span is moved to allow passage of a vessel.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>6</sc:sequenceNumber>
         <sc:typeId>C85</sc:typeId>
         <sc:typeName>Bridge_bridgeOpeningTypeMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>bridgeReferenceNumber</sc:name>
         <sc:id>C9_7</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The unique identifier of a bridge in accordance with the provisions of terrain analysis databases (for example: PTADB or TTADB).
-- Description --
The identifier is assigned consecutively (for example: within a map sheet or within a local area of interest) and begins with the northwest grid square of the UTM reference system and proceeds from left to right to the east edge of the sheet or area, continuing consecutively in the same way starting back at the west edge of the next line of UTM grid squares below those previously completed. The resulting identifiers are used to index an associated Bridge Information Table.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>7</sc:sequenceNumber>
         <sc:typeId>C20</sc:typeId>
         <sc:typeName>CharacterStringMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>bridgeStructureType</sc:name>
         <sc:id>C9_8</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The type(s) of structural design of a bridge, bridge span, or bridge superstructure.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..*</sc:cardinality>
         <sc:sequenceNumber>8</sc:sequenceNumber>
         <sc:typeId>C86</sc:typeId>
         <sc:typeName>Bridge_bridgeStructureTypeMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>bypassCondition</sc:name>
         <sc:id>C9_9</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The ease or ability to circumvent a destroyed section of bridge, tunnel or pass within a distance of two kilometres from the feature.
-- Description --
Bypass condition will not consider other bridges in bypass determination.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>9</sc:sequenceNumber>
         <sc:typeId>C87</sc:typeId>
         <sc:typeName>Bridge_bypassConditionMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>colourPattern</sc:name>
         <sc:id>C9_10</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The colour pattern(s) of an aid to navigation (for example: a buoy, a beacon, and/or a navigation light) or other feature of importance to maritime navigation.
-- Description --
The Attribute: 'Navigation Mark Colour' may be used to specify the colours in the order in which they appear in the pattern.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>10</sc:sequenceNumber>
         <sc:typeId>C88</sc:typeId>
         <sc:typeName>Bridge_colourPatternMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>conspicuousAirCategory</sc:name>
         <sc:id>C9_11</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The manner in which an object is conspicuous when viewed from the air.
-- Description --
A conspicuous feature is easily detected and identified under varying conditions (for example: lighting). Factors affecting conspicuousness include size, shape, and/or height.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>11</sc:sequenceNumber>
         <sc:typeId>C89</sc:typeId>
         <sc:typeName>Bridge_conspicuousAirCategoryMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>conspicuousGroundCategory</sc:name>
         <sc:id>C9_12</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The manner in which an object is conspicuous when viewed from on the ground.
-- Description --
A conspicuous feature is easily detected and identified under varying conditions (for example: lighting). Factors affecting conspicuousness include size, shape, and/or height.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>12</sc:sequenceNumber>
         <sc:typeId>C90</sc:typeId>
         <sc:typeName>Bridge_conspicuousGroundCategoryMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>conspicuousSeaCategory</sc:name>
         <sc:id>C9_13</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The manner in which an object is conspicuous when viewed from the sea.
-- Description --
A conspicuous feature is easily detected and identified under varying conditions (for example: lighting). Factors affecting conspicuousness include size, shape, and/or height.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>13</sc:sequenceNumber>
         <sc:typeId>C91</sc:typeId>
         <sc:typeName>Bridge_conspicuousSeaCategoryMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>controllingAuthority</sc:name>
         <sc:id>C9_14</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The controlling authority responsible for a facility or site.
-- Description --
Controlling authorities may be distinguished by organizational level (for example: national, sub-national, or military district) and/or type (for example: private or public).
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>14</sc:sequenceNumber>
         <sc:typeId>C92</sc:typeId>
         <sc:typeName>Bridge_controllingAuthorityMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>deckCount</sc:name>
         <sc:id>C9_15</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The number of vertically stacked decks, one over another, in a transportation structure (for example: a bridge or a tunnel).
-- Description --
-- UnitOfMeasure --
unitless</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>15</sc:sequenceNumber>
         <sc:typeId>C52</sc:typeId>
         <sc:typeName>IntegerMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>elevationMsl</sc:name>
         <sc:id>C9_16</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The vertical distance of a point or a level, on or affixed to the surface of the Earth, measured from Mean Sea Level (MSL).
-- Description --
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>16</sc:sequenceNumber>
         <sc:typeId>C23</sc:typeId>
         <sc:typeName>MeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>facilityOperationalStatus</sc:name>
         <sc:id>C9_17</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The status of operation of a man-made structure, as a whole.
-- Description --
Includes actual operations, operational capability, and planned or proposed man-made structures.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>17</sc:sequenceNumber>
         <sc:typeId>C93</sc:typeId>
         <sc:typeName>Bridge_facilityOperationalStatusMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>heightAboveSurfaceLevel</sc:name>
         <sc:id>C9_18</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The vertical distance measured from the lowest point of the base of the feature at ground or water level (downhill/downstream side) to the tallest point of the feature.
-- Description --
For non-inland water bodies, the water level is usually understood to be Mean Sea Level (MSL). Note that the feature may be supported above the surface by another feature (for example: a tower supported by a building) and as a consequence the value of the Height Above Surface Level is different (larger) than the base-to-top height of the feature (for example: supported tower) itself.
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>18</sc:sequenceNumber>
         <sc:typeId>C38</sc:typeId>
         <sc:typeName>HeightMeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>highestElevation</sc:name>
         <sc:id>C9_19</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The elevation from a specified vertical datum to the highest point on a feature.
-- Description --
In the case of multiple features that may be stacked on each other (for example: a railway on a bridge, a superstructure on a building, or an aerial on a tower) the highest elevation is that of the entire feature stack. For example, the highest elevation of a church is that of its steeple and not that of the roof of the church itself. The church itself may have a height above surface level that excludes the additional height of the steeple superstructure located on the church roof.
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>19</sc:sequenceNumber>
         <sc:typeId>C39</sc:typeId>
         <sc:typeName>ElevationMeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>horizontalClearance</sc:name>
         <sc:id>C9_20</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The distance available to pass a load that extends laterally beyond the wheels of a vehicle.
-- Description --
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>20</sc:sequenceNumber>
         <sc:typeId>C31</sc:typeId>
         <sc:typeName>MeasureIntervalMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>loadClassType1</sc:name>
         <sc:id>C9_21</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The dynamic live load weight-bearing capacity of a bridge or bridge span for one-way, wheeled vehicle traffic in MLC units.
-- Description --
Military load classification values are calculated in part from the size, cross-sectional shape, and material of the stringers under the bridge span; they are similar to, but not the same as, short tons. See STANAGs 2021 and 2253 for the method of calculation.
-- UnitOfMeasure --
militaryLoadClass</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>21</sc:sequenceNumber>
         <sc:typeId>C52</sc:typeId>
         <sc:typeName>IntegerMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>loadClassType2</sc:name>
         <sc:id>C9_22</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The dynamic live load weight-bearing capacity of a bridge or bridge span for two-way, wheeled vehicle traffic in MLC units.
-- Description --
Military load classification values are calculated in part from the size, cross-sectional shape, and material of the stringers under the bridge span; they are similar to, but not the same as, short tons. See STANAGs 2021 and 2253 for the method of calculation.
-- UnitOfMeasure --
militaryLoadClass</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>22</sc:sequenceNumber>
         <sc:typeId>C52</sc:typeId>
         <sc:typeName>IntegerMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>loadClassType3</sc:name>
         <sc:id>C9_23</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The dynamic live load weight-bearing capacity of a bridge or bridge span for one-way, tracked vehicle traffic in MLC units.
-- Description --
Military load classification values are calculated in part from the size, cross-sectional shape, and material of the stringers under the bridge span; they are similar to, but not the same as, short tons. See STANAGs 2021 and 2253 for the method of calculation.
-- UnitOfMeasure --
militaryLoadClass</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>23</sc:sequenceNumber>
         <sc:typeId>C52</sc:typeId>
         <sc:typeName>IntegerMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>loadClassType4</sc:name>
         <sc:id>C9_24</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The dynamic live load weight-bearing capacity of a bridge or bridge span for two-way, tracked vehicle traffic in MLC units.
-- Description --
Military load classification values are calculated in part from the size, cross-sectional shape, and material of the stringers under the bridge span; they are similar to, but not the same as, short tons. See STANAGs 2021 and 2253 for the method of calculation.
-- UnitOfMeasure --
militaryLoadClass</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>24</sc:sequenceNumber>
         <sc:typeId>C52</sc:typeId>
         <sc:typeName>IntegerMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>maritimeNavigationMarked</sc:name>
         <sc:id>C9_25</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that a feature is significant to maritime safety of navigation and is marked (for example: by a light or beacon) by a maritime-specific navigational aid.
-- Description --
Mariners may also use other prominent features (for example: rotating aeronautical beacons or lighted structures) for informal navigational purposes.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>25</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>maximumVerticalClearance</sc:name>
         <sc:id>C9_26</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The greatest distance between the travelled way and any obstruction vertically above it.
-- Description --
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>26</sc:sequenceNumber>
         <sc:typeId>C23</sc:typeId>
         <sc:typeName>MeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>militaryBridgeInformation</sc:name>
         <sc:id>C9_27</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
Information describing a bridge, typically one that is subject to preplanned military interdiction.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>27</sc:sequenceNumber>
         <sc:typeId>C20</sc:typeId>
         <sc:typeName>CharacterStringMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>mobileBridgeSpan</sc:name>
         <sc:id>C9_28</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that a bridge span moves in some manner to allow passage underneath.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>28</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>navigationMarkColour</sc:name>
         <sc:id>C9_29</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The colour(s) of a International Association of Lighthouse Authorities (IALA) navigation mark.
-- Description --
When the navigation mark is patterned, the Attribute: 'Colour Pattern' may be used to identify the pattern and a corresponding list of colours specified.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..*</sc:cardinality>
         <sc:sequenceNumber>29</sc:sequenceNumber>
         <sc:typeId>C94</sc:typeId>
         <sc:typeName>Bridge_navigationMarkColourMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>overheadClearance</sc:name>
         <sc:id>C9_30</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The least distance between the travelled way and any obstruction vertically above it.
-- Description --
Reference STANAG 2253.
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>30</sc:sequenceNumber>
         <sc:typeId>C23</sc:typeId>
         <sc:typeName>MeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>permanent</sc:name>
         <sc:id>C9_31</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that a feature is permanent.
-- Description --
Temporary features last, or are meant to last, for a limited time only.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>31</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>physicalCondition</sc:name>
         <sc:id>C9_32</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The physical condition of a man-made structure, as a whole, including the inside and/or outside of the structure and any contained and/or associated equipment.
-- Description --
The physical condition applies to any phase of the life cycle of a man-made structure from construction to destruction. Examples of man-made structures include roads, canals, buildings, towers, aerodromes and facilities.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>32</sc:sequenceNumber>
         <sc:typeId>C95</sc:typeId>
         <sc:typeName>Bridge_physicalConditionMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>radarSignificance</sc:name>
         <sc:id>C9_33</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The predominant exposed surface material, categorized by its significance to radar-based sensors.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>33</sc:sequenceNumber>
         <sc:typeId>C96</sc:typeId>
         <sc:typeName>Bridge_radarSignificanceMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>restrictHorizClearance</sc:name>
         <sc:id>C9_34</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that horizontal clearance for vehicles on a land transportation route is restricted.
-- Description --
Horizontal clearance affects the maximum width of loads that extend laterally beyond the wheels of a vehicle.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>34</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>restrictOverheadClearance</sc:name>
         <sc:id>C9_35</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that there is an overhead obstruction located less than 4.3 metres above a land transportation route.
-- Description --
Vertical clearance affects the maximum height of vehicle loads. (Reference STANAG 2253)
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>35</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>roofed</sc:name>
         <sc:id>C9_36</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that a feature is covered by a roof.
-- Description --
The roof may be supported by spaced pillars with intervening openings or the sides may be completely closed (for example: by walls or windows) and thus afford substantial protection from the weather.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>36</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>spanCount</sc:name>
         <sc:id>C9_37</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The number of spans in a bridge.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>37</sc:sequenceNumber>
         <sc:typeId>C52</sc:typeId>
         <sc:typeName>IntegerMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>underbridgeClearance</sc:name>
         <sc:id>C9_38</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
Clearance below bridge, measured from the lowest surface level to the base of the lower of either a cross beam or the lowest bridge deck.
-- Description --
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>38</sc:sequenceNumber>
         <sc:typeId>C31</sc:typeId>
         <sc:typeName>MeasureIntervalMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>verticalClearanceSafe</sc:name>
         <sc:id>C9_39</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The safe vertical clearance of an object measured from the horizontal plane toward the object overhead.
-- Description --
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>39</sc:sequenceNumber>
         <sc:typeId>C54</sc:typeId>
         <sc:typeName>HydroClearRefMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>waterbodyOverheadObstruct</sc:name>
         <sc:id>C9_40</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that an object is an overhead obstruction over a navigable waterbody.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>40</sc:sequenceNumber>
         <sc:typeName>CharacterString</sc:typeName>
        </sc:Property>
       </sc:properties>
      </sc:Class>
      <sc:Class>
       <sc:name>Tunnel</sc:name>
       <sc:id>C10</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>-- Definition --
An underground passage that is open at both ends and usually contains a land transportation route (for example: a road and/or a railway).
-- Description --
Commonly used to pass through a hill or mountain, or under a river or road. May also provide underground passage in a mine.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:supertypes>
        <sc:SupertypeId>C13</sc:SupertypeId>
       </sc:supertypes>
       <sc:properties>
        <sc:Property>
         <sc:name>angleOfIntendedPassage</sc:name>
         <sc:id>C10_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The angular distance in the horizontal plane measured from true north (0 degrees) clockwise to the path on the feature (0-180 degrees) where passage was intended.
-- Description --
The path of intended passage may go across or over the feature (ex. a bridge) or through it (ex. a tunnel).
-- UnitOfMeasure --
arcDegree</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeId>C43</sc:typeId>
         <sc:typeName>AngleMeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>bypassCondition</sc:name>
         <sc:id>C10_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The ease or ability to circumvent a destroyed section of bridge, tunnel or pass within a distance of two kilometres from the feature.
-- Description --
Bypass condition will not consider other bridges in bypass determination.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeId>C97</sc:typeId>
         <sc:typeName>Tunnel_bypassConditionMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>controllingAuthority</sc:name>
         <sc:id>C10_3</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The controlling authority responsible for a facility or site.
-- Description --
Controlling authorities may be distinguished by organizational level (for example: national, sub-national, or military district) and/or type (for example: private or public).
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>3</sc:sequenceNumber>
         <sc:typeId>C98</sc:typeId>
         <sc:typeName>Tunnel_controllingAuthorityMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>controllingAuthorityIdent</sc:name>
         <sc:id>C10_4</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The recognized authority responsible for establishing and maintaining the administrative affairs of all matters relating to a particular field or subject.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..*</sc:cardinality>
         <sc:sequenceNumber>4</sc:sequenceNumber>
         <sc:typeId>C20</sc:typeId>
         <sc:typeName>CharacterStringMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>crossSectionalProfile</sc:name>
         <sc:id>C10_5</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The cross-sectional profile of an opening (for example: a tunnel or the space under a bridge span).
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>5</sc:sequenceNumber>
         <sc:typeId>C99</sc:typeId>
         <sc:typeName>Tunnel_crossSectionalProfileMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>deckCount</sc:name>
         <sc:id>C10_6</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The number of vertically stacked decks, one over another, in a transportation structure (for example: a bridge or a tunnel).
-- Description --
-- UnitOfMeasure --
unitless</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>6</sc:sequenceNumber>
         <sc:typeId>C52</sc:typeId>
         <sc:typeName>IntegerMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>deepDepthBelowSurfLevel</sc:name>
         <sc:id>C10_7</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The distance measured from ground or water level (uphill/upstream side of the feature) to the deepest point of the feature.
-- Description --
May be used to measure the depth of an inland waterbody (for example: a lake), the depth of a terrain surface depression or excavation (for example: a crevice or trench), the distance to the deepest point of a drilled feature (for example: a water well or borehole) or the distance to the deepest point of a feature located entirely underground (for example: a cave chamber). In the case of a feature located below a waterbody (for example: a non-water well) the reference surface is the waterbody bottom, rather than the waterbody surface.
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>7</sc:sequenceNumber>
         <sc:typeId>C23</sc:typeId>
         <sc:typeName>MeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>facilityOperationalStatus</sc:name>
         <sc:id>C10_8</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The status of operation of a man-made structure, as a whole.
-- Description --
Includes actual operations, operational capability, and planned or proposed man-made structures.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>8</sc:sequenceNumber>
         <sc:typeId>C100</sc:typeId>
         <sc:typeName>Tunnel_facilityOperationalStatusMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>hazardShelterIntendedUse</sc:name>
         <sc:id>C10_9</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The intended use(s) of a designated hazard protection shelter based on the kind of emergency.
-- Description --
Hazard shelters may be located inside buildings or other structures. Shelters may be equipped with disaster supplies and equipment such as food and cots.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..*</sc:cardinality>
         <sc:sequenceNumber>9</sc:sequenceNumber>
         <sc:typeId>C101</sc:typeId>
         <sc:typeName>Tunnel_hazardShelterIntendedUseMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>heightAboveSurfaceLevel</sc:name>
         <sc:id>C10_10</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The vertical distance measured from the lowest point of the base of the feature at ground or water level (downhill/downstream side) to the tallest point of the feature.
-- Description --
For non-inland water bodies, the water level is usually understood to be Mean Sea Level (MSL). Note that the feature may be supported above the surface by another feature (for example: a tower supported by a building) and as a consequence the value of the Height Above Surface Level is different (larger) than the base-to-top height of the feature (for example: supported tower) itself.
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>10</sc:sequenceNumber>
         <sc:typeId>C38</sc:typeId>
         <sc:typeName>HeightMeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>horizontalClearance</sc:name>
         <sc:id>C10_11</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The distance available to pass a load that extends laterally beyond the wheels of a vehicle.
-- Description --
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>11</sc:sequenceNumber>
         <sc:typeId>C31</sc:typeId>
         <sc:typeName>MeasureIntervalMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>leastDepthBelowSurfLevel</sc:name>
         <sc:id>C10_12</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The distance measured from ground or water level (uphill/upstream side of the feature) to the highest point of a feature located completely underground.
-- Description --
For example, in the case of an underground dwelling the least depth below surface level would be measured to its ceiling. The least depth below surface level may be located at ground or water level and therefore have a value of zero (for example: an opencast extraction mine, a terrain depression or a lake). For depths defined with respect to a time-varying water level, consideration should be given to the use of Attribute: 'Hydrographic Depth'.
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>12</sc:sequenceNumber>
         <sc:typeId>C23</sc:typeId>
         <sc:typeName>MeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>manMade</sc:name>
         <sc:id>C10_13</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that a feature is man-made.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>13</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>maximumVerticalClearance</sc:name>
         <sc:id>C10_14</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The greatest distance between the travelled way and any obstruction vertically above it.
-- Description --
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>14</sc:sequenceNumber>
         <sc:typeId>C23</sc:typeId>
         <sc:typeName>MeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>monitored</sc:name>
         <sc:id>C10_15</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that a feature is actively monitored.
-- Description --
For example, attended or watched over by personnel.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>15</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>overheadClearance</sc:name>
         <sc:id>C10_16</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The least distance between the travelled way and any obstruction vertically above it.
-- Description --
Reference STANAG 2253.
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>16</sc:sequenceNumber>
         <sc:typeId>C23</sc:typeId>
         <sc:typeName>MeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>pedestrianTraversable</sc:name>
         <sc:id>C10_17</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that a feature is traversable on foot.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>17</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>permanent</sc:name>
         <sc:id>C10_18</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that a feature is permanent.
-- Description --
Temporary features last, or are meant to last, for a limited time only.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>18</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>physicalCondition</sc:name>
         <sc:id>C10_19</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The physical condition of a man-made structure, as a whole, including the inside and/or outside of the structure and any contained and/or associated equipment.
-- Description --
The physical condition applies to any phase of the life cycle of a man-made structure from construction to destruction. Examples of man-made structures include roads, canals, buildings, towers, aerodromes and facilities.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>19</sc:sequenceNumber>
         <sc:typeId>C102</sc:typeId>
         <sc:typeName>Tunnel_physicalConditionMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>restrictHorizClearance</sc:name>
         <sc:id>C10_20</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that horizontal clearance for vehicles on a land transportation route is restricted.
-- Description --
Horizontal clearance affects the maximum width of loads that extend laterally beyond the wheels of a vehicle.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>20</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>routeTotalUsableWidth</sc:name>
         <sc:id>C10_21</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The total usable width of the travelled way of a route.
-- Description --
Includes pavements and shoulders.
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>21</sc:sequenceNumber>
         <sc:typeId>C31</sc:typeId>
         <sc:typeName>MeasureIntervalMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>safeHorizontalClearance</sc:name>
         <sc:id>C10_22</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
Minimum safe horizontal distance between adjacent structures on either side of a navigable channel.
-- Description --
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>22</sc:sequenceNumber>
         <sc:typeId>C23</sc:typeId>
         <sc:typeName>MeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>structMatType</sc:name>
         <sc:id>C10_23</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The primary type(s) of material composing a feature, exclusive of the surface.
-- Description --
The basis for 'primary' may be, for example, compositional dominance or structural organization.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..*</sc:cardinality>
         <sc:sequenceNumber>23</sc:sequenceNumber>
         <sc:typeId>C103</sc:typeId>
         <sc:typeName>Tunnel_structMatTypeMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>verticalRelativeLocation</sc:name>
         <sc:id>C10_24</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The relationship between the feature and the underlying ground (terrain) or waterbody bottom.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>24</sc:sequenceNumber>
         <sc:typeId>C104</sc:typeId>
         <sc:typeName>Tunnel_verticalRelativeLocationMeta</sc:typeName>
        </sc:Property>
       </sc:properties>
      </sc:Class>
      <sc:Class>
       <sc:name>TransRouteProtectStruct</sc:name>
       <sc:id>C11</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>-- Definition --
A structure built over and/or along a transportation route designed to prevent damage to, or blockage of, the route from rock slides, snow slides and/or weather phenomena.
-- Description --
For example, a snow shed, a rock shed or a gallery. These structures are usually located in rugged mountainous regions.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:supertypes>
        <sc:SupertypeId>C13</sc:SupertypeId>
       </sc:supertypes>
       <sc:properties>
        <sc:Property>
         <sc:name>structMatType</sc:name>
         <sc:id>C11_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The primary type(s) of material composing a feature, exclusive of the surface.
-- Description --
The basis for 'primary' may be, for example, compositional dominance or structural organization.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..*</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeId>C105</sc:typeId>
         <sc:typeName>TransRouteProtectStruct_structMatTypeMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>conspicuousAirCategory</sc:name>
         <sc:id>C11_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The manner in which an object is conspicuous when viewed from the air.
-- Description --
A conspicuous feature is easily detected and identified under varying conditions (for example: lighting). Factors affecting conspicuousness include size, shape, and/or height.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeId>C106</sc:typeId>
         <sc:typeName>TransRouteProtectStruct_conspicuousAirCategoryMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>conspicuousGroundCategory</sc:name>
         <sc:id>C11_3</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The manner in which an object is conspicuous when viewed from on the ground.
-- Description --
A conspicuous feature is easily detected and identified under varying conditions (for example: lighting). Factors affecting conspicuousness include size, shape, and/or height.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>3</sc:sequenceNumber>
         <sc:typeId>C107</sc:typeId>
         <sc:typeName>TransRouteProtectStruct_conspicuousGroundCategoryMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>controllingAuthorityIdent</sc:name>
         <sc:id>C11_4</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The recognized authority responsible for establishing and maintaining the administrative affairs of all matters relating to a particular field or subject.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..*</sc:cardinality>
         <sc:sequenceNumber>4</sc:sequenceNumber>
         <sc:typeId>C20</sc:typeId>
         <sc:typeName>CharacterStringMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>conspicuousSeaCategory</sc:name>
         <sc:id>C11_5</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The manner in which an object is conspicuous when viewed from the sea.
-- Description --
A conspicuous feature is easily detected and identified under varying conditions (for example: lighting). Factors affecting conspicuousness include size, shape, and/or height.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>5</sc:sequenceNumber>
         <sc:typeId>C108</sc:typeId>
         <sc:typeName>TransRouteProtectStruct_conspicuousSeaCategoryMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>controllingAuthority</sc:name>
         <sc:id>C11_6</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The controlling authority responsible for a facility or site.
-- Description --
Controlling authorities may be distinguished by organizational level (for example: national, sub-national, or military district) and/or type (for example: private or public).
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>6</sc:sequenceNumber>
         <sc:typeId>C109</sc:typeId>
         <sc:typeName>TransRouteProtectStruct_controllingAuthorityMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>facilityOperationalStatus</sc:name>
         <sc:id>C11_7</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The status of operation of a man-made structure, as a whole.
-- Description --
Includes actual operations, operational capability, and planned or proposed man-made structures.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>7</sc:sequenceNumber>
         <sc:typeId>C110</sc:typeId>
         <sc:typeName>TransRouteProtectStruct_facilityOperationalStatusMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>floodlit</sc:name>
         <sc:id>C11_8</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that a structure is floodlit.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>8</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>heightAboveSurfaceLevel</sc:name>
         <sc:id>C11_9</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The vertical distance measured from the lowest point of the base of the feature at ground or water level (downhill/downstream side) to the tallest point of the feature.
-- Description --
For non-inland water bodies, the water level is usually understood to be Mean Sea Level (MSL). Note that the feature may be supported above the surface by another feature (for example: a tower supported by a building) and as a consequence the value of the Height Above Surface Level is different (larger) than the base-to-top height of the feature (for example: supported tower) itself.
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>9</sc:sequenceNumber>
         <sc:typeId>C38</sc:typeId>
         <sc:typeName>HeightMeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>highestElevation</sc:name>
         <sc:id>C11_10</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The elevation from a specified vertical datum to the highest point on a feature.
-- Description --
In the case of multiple features that may be stacked on each other (for example: a railway on a bridge, a superstructure on a building, or an aerial on a tower) the highest elevation is that of the entire feature stack. For example, the highest elevation of a church is that of its steeple and not that of the roof of the church itself. The church itself may have a height above surface level that excludes the additional height of the steeple superstructure located on the church roof.
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>10</sc:sequenceNumber>
         <sc:typeId>C39</sc:typeId>
         <sc:typeName>ElevationMeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>horizontalClearance</sc:name>
         <sc:id>C11_11</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The distance available to pass a load that extends laterally beyond the wheels of a vehicle.
-- Description --
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>11</sc:sequenceNumber>
         <sc:typeId>C31</sc:typeId>
         <sc:typeName>MeasureIntervalMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>overheadClearance</sc:name>
         <sc:id>C11_12</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The least distance between the travelled way and any obstruction vertically above it.
-- Description --
Reference STANAG 2253.
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>12</sc:sequenceNumber>
         <sc:typeId>C23</sc:typeId>
         <sc:typeName>MeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>permanent</sc:name>
         <sc:id>C11_13</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that a feature is permanent.
-- Description --
Temporary features last, or are meant to last, for a limited time only.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>13</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>physicalCondition</sc:name>
         <sc:id>C11_14</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The physical condition of a man-made structure, as a whole, including the inside and/or outside of the structure and any contained and/or associated equipment.
-- Description --
The physical condition applies to any phase of the life cycle of a man-made structure from construction to destruction. Examples of man-made structures include roads, canals, buildings, towers, aerodromes and facilities.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>14</sc:sequenceNumber>
         <sc:typeId>C111</sc:typeId>
         <sc:typeName>TransRouteProtectStruct_physicalConditionMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>restrictHorizClearance</sc:name>
         <sc:id>C11_15</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
An indication that horizontal clearance for vehicles on a land transportation route is restricted.
-- Description --
Horizontal clearance affects the maximum width of loads that extend laterally beyond the wheels of a vehicle.
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>15</sc:sequenceNumber>
         <sc:typeId>C25</sc:typeId>
         <sc:typeName>BooleanMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>safeHorizontalClearance</sc:name>
         <sc:id>C11_16</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
Minimum safe horizontal distance between adjacent structures on either side of a navigable channel.
-- Description --
-- UnitOfMeasure --
metre</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>16</sc:sequenceNumber>
         <sc:typeId>C23</sc:typeId>
         <sc:typeName>MeasureMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>transRteProtStructType</sc:name>
         <sc:id>C11_17</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The type of a transportation route protection structure based on its configuration and/or intended purpose.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>17</sc:sequenceNumber>
         <sc:typeId>C112</sc:typeId>
         <sc:typeName>TransRouteProtectStruct_transRteProtStructTypeMeta</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>verticalRelativeLocation</sc:name>
         <sc:id>C11_18</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>-- Definition --
The relationship between the feature and the underlying ground (terrain) or waterbody bottom.
-- Description --
-- UnitOfMeasure --</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>18</sc:sequenceNumber>
         <sc:typeId>C113</sc:typeId>
         <sc:typeName>TransRouteProtectStruct_verticalRelativeLocationMeta</sc:typeName>
        </sc:Property>
       </sc:properties>
      </sc:Class>
     </sc:classes>
