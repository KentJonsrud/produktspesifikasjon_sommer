  <element name="TransRouteProtectStruct" substitutionGroup="nydatakilde:FeatureEntity" type="nydatakilde:TransRouteProtectStructType">
    <annotation>
      <documentation>-- Definition --
A structure built over and/or along a transportation route designed to prevent damage to, or blockage of, the route from rock slides, snow slides and/or weather phenomena.
-- Description --
For example, a snow shed, a rock shed or a gallery. These structures are usually located in rugged mountainous regions.</documentation>
    </annotation>
  </element>
  <complexType name="TransRouteProtectStructType">
    <complexContent>
      <extension base="nydatakilde:FeatureEntityType">
        <sequence>
          <element maxOccurs="unbounded" minOccurs="0" name="structMatType" type="nydatakilde:TransRouteProtectStruct_structMatTypeMetaPropertyType">
            <annotation>
              <documentation>-- Definition --
The primary type(s) of material composing a feature, exclusive of the surface.
-- Description --
The basis for 'primary' may be, for example, compositional dominance or structural organization.
-- UnitOfMeasure --</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="conspicuousAirCategory" type="nydatakilde:TransRouteProtectStruct_conspicuousAirCategoryMetaPropertyType">
            <annotation>
              <documentation>-- Definition --
The manner in which an object is conspicuous when viewed from the air.
-- Description --
A conspicuous feature is easily detected and identified under varying conditions (for example: lighting). Factors affecting conspicuousness include size, shape, and/or height.
-- UnitOfMeasure --</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="conspicuousGroundCategory" type="nydatakilde:TransRouteProtectStruct_conspicuousGroundCategoryMetaPropertyType">
            <annotation>
              <documentation>-- Definition --
The manner in which an object is conspicuous when viewed from on the ground.
-- Description --
A conspicuous feature is easily detected and identified under varying conditions (for example: lighting). Factors affecting conspicuousness include size, shape, and/or height.
-- UnitOfMeasure --</documentation>
            </annotation>
          </element>
          <element maxOccurs="unbounded" minOccurs="0" name="controllingAuthorityIdent" type="nydatakilde:CharacterStringMetaPropertyType">
            <annotation>
              <documentation>-- Definition --
The recognized authority responsible for establishing and maintaining the administrative affairs of all matters relating to a particular field or subject.
-- Description --
-- UnitOfMeasure --</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="conspicuousSeaCategory" type="nydatakilde:TransRouteProtectStruct_conspicuousSeaCategoryMetaPropertyType">
            <annotation>
              <documentation>-- Definition --
The manner in which an object is conspicuous when viewed from the sea.
-- Description --
A conspicuous feature is easily detected and identified under varying conditions (for example: lighting). Factors affecting conspicuousness include size, shape, and/or height.
-- UnitOfMeasure --</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="controllingAuthority" type="nydatakilde:TransRouteProtectStruct_controllingAuthorityMetaPropertyType">
            <annotation>
              <documentation>-- Definition --
The controlling authority responsible for a facility or site.
-- Description --
Controlling authorities may be distinguished by organizational level (for example: national, sub-national, or military district) and/or type (for example: private or public).
-- UnitOfMeasure --</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="facilityOperationalStatus" type="nydatakilde:TransRouteProtectStruct_facilityOperationalStatusMetaPropertyType">
            <annotation>
              <documentation>-- Definition --
