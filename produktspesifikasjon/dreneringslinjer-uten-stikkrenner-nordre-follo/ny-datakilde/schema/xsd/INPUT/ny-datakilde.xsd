-- UnitOfMeasure --
metre</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="verticalClearanceSafe" type="nydatakilde:HydroClearRefMetaPropertyType">
            <annotation>
              <documentation>-- Definition --
The safe vertical clearance of an object measured from the horizontal plane toward the object overhead.
-- Description --
-- UnitOfMeasure --
metre</documentation>
            </annotation>
          </element>
          <element minOccurs="0" name="waterbodyOverheadObstruct" type="nydatakilde:BooleanMetaPropertyType">
