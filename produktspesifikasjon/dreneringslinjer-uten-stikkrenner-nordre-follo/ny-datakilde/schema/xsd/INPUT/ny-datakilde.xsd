  <element name="Tunnel" substitutionGroup="nydatakilde:FeatureEntity" type="nydatakilde:TunnelType">
    <annotation>
      <documentation>-- Definition --
An underground passage that is open at both ends and usually contains a land transportation route (for example: a road and/or a railway).
-- Description --
Commonly used to pass through a hill or mountain, or under a river or road. May also provide underground passage in a mine.</documentation>
    </annotation>
